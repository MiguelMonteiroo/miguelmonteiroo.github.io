---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Miguel Monteiro</title>
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.setProperty('color-scheme', theme);
        var bg = theme === 'dark' ? '#0a0a0a' : '#ffffff';
        document.documentElement.style.backgroundColor = bg;
        addEventListener('DOMContentLoaded', function () {
          document.documentElement.style.backgroundColor = '';
        });
      })();
    </script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&display=swap');
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Miguel Monteiro</a>
        <div class="nav-links">
          <a href="/">Início</a>
          <a href="/posts">Posts</a>
        </div>
        <button id="theme-toggle" aria-label="Alternar tema">
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Miguel Monteiro</p>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      const stored = localStorage.getItem('theme');
      if (stored) html.setAttribute('data-theme', stored);
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) html.setAttribute('data-theme', 'dark');
      toggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --bg-secondary: #f5f5f5;
    --text: #111111;
    --text-secondary: #666666;
    --border: #e5e5e5;
    --accent: #111111;
    --font: 'Inter', system-ui, -apple-system, sans-serif;
    --max-width: 680px;
    --font-mono: 'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', monospace;
  }

  [data-theme="dark"] {
    --bg: #0a0a0a;
    --bg-secondary: #1a1a1a;
    --text: #f0f0f0;
    --text-secondary: #888888;
    --border: #2a2a2a;
    --accent: #f0f0f0;
  }

  * { box-sizing: border-box; }

  html {
    background: var(--bg);
    color-scheme: light;
    transition: background 0.3s;
  }

  [data-theme="dark"] {
    color-scheme: dark;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font);
    color: var(--text);
    line-height: 1.6;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    transition: color 0.3s;
  }

  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
    transition: background 0.3s, border-color 0.3s;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  nav .logo {
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .nav-links { display: flex; gap: 16px; }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--text); }

  #theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, border-color 0.2s;
  }

  #theme-toggle:hover { color: var(--text); border-color: var(--text-secondary); }

  [data-theme="light"] .moon { display: block; }
  [data-theme="light"] .sun { display: none; }
  [data-theme="dark"] .sun { display: block; }
  [data-theme="dark"] .moon { display: none; }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 24px;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 13px;
    color: var(--text-secondary);
    transition: border-color 0.3s;
  }

  a { color: var(--accent); }
  a:hover { opacity: 0.7; }

  img { max-width: 100%; height: auto; }

  h1 { font-size: 28px; font-weight: 700; line-height: 1.3; margin: 0 0 16px; }
  h2 { font-size: 22px; font-weight: 600; margin: 32px 0 12px; }
  h3 { font-size: 18px; font-weight: 600; margin: 24px 0 8px; }

  p { margin: 0 0 16px; color: var(--text); }

  code {
    font-family: var(--font-mono);
    font-size: 14px;
    background: var(--bg-secondary);
    padding: 2px 6px;
    border-radius: 4px;
  }

  pre {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.5;
  }

  pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  blockquote {
    border-left: 3px solid var(--border);
    margin: 0 0 16px;
    padding: 0 0 0 16px;
    color: var(--text-secondary);
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }

  @media (max-width: 600px) {
    main { padding: 32px 16px 64px; }
    h1 { font-size: 24px; }
  }
</style>
