---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import postDates from '../data/post-dates.json';

const allPosts = await getCollection('posts');
const sorted = allPosts
  .map((p) => ({
    slug: p.id.replace(/\.md$/, '').replace(/\/index\.md$/, ''),
    title: p.data.title,
    date: postDates[p.id.replace(/\.md$/, '').replace(/\/index\.md$/, '')] || null,
  }))
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 5);
---

<Layout title="Início">
  <section class="hero">
    <div class="avatar">
      <img src="/images/avatar.svg" alt="Miguel Monteiro" width="96" height="96" />
    </div>
    <h1>Miguel Monteiro</h1>
    <p class="bio">
      Desenvolvedor. Escrevo sobre meus estudos, projetos e descobertas em tecnologia.
    </p>
    <div class="social-links">
      <a href="mailto:monteiro.miguel05@gmail.com" aria-label="Email">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
      <a href="https://github.com/MiguelMonteiroo" aria-label="GitHub" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/miguel-monteiro-3a3675231/" aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
  </section>

  <section class="latest-posts">
    <h2>Posts Recentes</h2>
    {sorted.length > 0 ? (
      <ul class="post-list">
        {sorted.map((post) => (
          <li>
            <a href={`/posts/${post.slug}`}>
              <span class="post-title">{post.title}</span>
              {post.date && <time datetime={post.date}>{new Date(post.date).toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">Nenhum post ainda.</p>
    )}
    {allPosts.length > 5 && (
      <a href="/posts" class="see-all">Ver todos os posts &rarr;</a>
    )}
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 64px;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 20px;
    background: var(--bg-secondary);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero h1 {
    font-size: 32px;
    margin-bottom: 8px;
  }

  .bio {
    color: var(--text-secondary);
    font-size: 15px;
    max-width: 480px;
    margin: 0 auto 24px;
  }

  .social-links {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .social-links a {
    color: var(--text-secondary);
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, border-color 0.2s;
  }

  .social-links a:hover {
    color: var(--text);
    border-color: var(--text-secondary);
    opacity: 1;
  }

  .latest-posts h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    text-decoration: none;
    color: var(--text);
    transition: opacity 0.2s;
  }

  .post-list a:hover {
    opacity: 0.7;
  }

  .post-title {
    font-size: 15px;
    font-weight: 500;
  }

  .post-list time {
    font-size: 13px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .empty {
    color: var(--text-secondary);
    font-size: 14px;
  }

  .see-all {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .see-all:hover { color: var(--text); }
</style>
