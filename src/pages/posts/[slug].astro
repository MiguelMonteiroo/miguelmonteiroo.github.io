---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import postDates from '../../data/post-dates.json';
import { slugFromId } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => {
    const slug = slugFromId(post.id);
    return { params: { slug }, props: { post, slug } };
  });
}

const { post, slug } = Astro.props;
const { Content } = await render(post);
const postDate = postDates[slug] || null;
---

<Layout title={post.data.title}>
  <a href="/posts" class="back-link">&larr; Todos os posts</a>
  <article>
    <header class="post-header">
      <div class="title-row">
        <h1>{post.data.title}</h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="tags" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      {postDate && (
        <time datetime={postDate}>
          {new Date(postDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      )}
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .back-link {
    display: inline-block;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 24px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text);
  }

  .post-header {
    margin-bottom: 48px;
  }

  .post-header h1 {
    font-size: 32px;
    margin-bottom: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .post-header time {
    display: block;
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 12px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid var(--border);
  }

  .content {
    font-size: 16px;
    line-height: 1.8;
  }

  .content :global(hr:first-child) {
    margin-top: 0;
  }

  .content p {
    margin-bottom: 20px;
    color: var(--text);
  }

  .content img {
    border-radius: 8px;
    margin: 24px 0;
  }

  .content :global(pre) {
    margin: 24px 0;
  }

  .content :global(code) {
    font-size: 14px;
  }

  .content :global(h2) {
    margin-top: 40px;
  }

  .content :global(h3) {
    margin-top: 32px;
  }
</style>
