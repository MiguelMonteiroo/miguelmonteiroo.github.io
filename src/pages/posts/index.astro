---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import postDates from '../../data/post-dates.json';
import { getSortedPosts } from '../../utils';

const allPosts = await getCollection('posts');
const sorted = getSortedPosts(allPosts, postDates);
---

<Layout title="Posts">
  <div class="page-header">
    <h1>Posts</h1>
    <div class="sort-control" aria-label="Ordenação dos posts">
      <span class="sort-label">Data</span>
      <button type="button" class="sort-button" data-sort-toggle data-order="desc" aria-label="Posts ordenados do mais novo para o mais antigo">
        <span aria-hidden="true">↓</span>
      </button>
    </div>
  </div>

  {sorted.length > 0 ? (
    <ul class="post-list" data-post-list>
      {sorted.map((post) => (
        <li data-date={post.date || ''}>
          <a href={`/posts/${post.slug}`}>
            <span class="post-info">
              <span class="post-title">{post.title}</span>
              {post.tags.length > 0 && (
                <span class="tags" aria-label="Tags">
                  {post.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
              )}
            </span>
            {post.date && <time datetime={post.date}>{new Date(post.date).toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">Nenhum post ainda.</p>
  )}
</Layout>

<script>
  const postList = document.querySelector('[data-post-list]');
  const sortButton = document.querySelector<HTMLButtonElement>('[data-sort-toggle]');

  sortButton?.addEventListener('click', () => {
    const currentOrder = sortButton.dataset.order || 'desc';
    const nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
    const posts = Array.from(postList?.children || []);

    posts
      .sort((a, b) => {
        const firstDate = (a as HTMLElement).dataset.date || '';
        const secondDate = (b as HTMLElement).dataset.date || '';
        return nextOrder === 'asc'
          ? firstDate.localeCompare(secondDate)
          : secondDate.localeCompare(firstDate);
      })
      .forEach((post) => postList?.appendChild(post));

    sortButton.dataset.order = nextOrder;
    sortButton.textContent = nextOrder === 'asc' ? '↑' : '↓';
    sortButton.setAttribute(
      'aria-label',
      nextOrder === 'asc'
        ? 'Posts ordenados do mais antigo para o mais novo'
        : 'Posts ordenados do mais novo para o mais antigo',
    );
  });
</script>

<style>
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }

  h1 {
    font-size: 28px;
    margin-bottom: 0;
  }

  .sort-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px 6px 4px 10px;
    background: var(--bg-secondary);
  }

  .sort-label {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1;
  }

  .sort-button {
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 16px;
    line-height: 1;
    border-radius: 6px;
  }

  .sort-button:hover {
    border-color: var(--text-secondary);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    text-decoration: none;
    color: var(--text);
    transition: opacity 0.2s;
  }

  .post-list a:hover {
    opacity: 0.7;
  }

  .post-title {
    font-size: 16px;
    font-weight: 500;
  }

  .post-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .tags {
    display: inline-flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 11px;
    line-height: 1;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 8px;
  }

  .post-list time {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .empty {
    color: var(--text-secondary);
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .page-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .post-list a {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
